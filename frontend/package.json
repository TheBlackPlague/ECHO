{
    "name": "echo-frontend",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "generate": "openapi-ts",
        "generate:check": "npm run generate && git diff --exit-code -- ../generated/openapi.json src/api/generated",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "build": "npm run generate && tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --pretty false",
        "check": "npm run typecheck && npm run build"
    },
    "dependencies": {
        "@tanstack/react-query": "5.101.4",
        "lucide-react": "1.31.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router-dom": "7.18.2"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "^0.97.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "@vitest/coverage-v8": "4.1.10",
        "jsdom": "30.0.1",
        "typescript": "6.0.3",
        "vite": "8.2.1",
        "vitest": "4.1.10"
    }
}
